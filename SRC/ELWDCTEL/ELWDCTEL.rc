/* ELWDCTEL.rc - Windows version resource for the Dice module DLL.          */
/* Keep the numbers in step with ELWDCTEL_VER_* and ELWDCTEL_VERSION        */
/* (DC_DEFS.H).                                                              */

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Elwynor Technologies"
            VALUE "FileDescription",  "Dice for Teleconference - Dice rolling in Teleconference for The Major BBS v10"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ELWDCTEL"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Elwynor Technologies. Originally HOTELeconference Dice by Randall R. Spangler, annex.com."
            VALUE "OriginalFilename", "ELWDCTEL.DLL"
            VALUE "ProductName",      "Dice for Teleconference"
            VALUE "ProductVersion",   "1.0.0"
            VALUE "Comments",         "Dice converted for The Major BBS v10 by Mark Laudenbach - https://github.com/laudenbachm"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
